{
  "expo": {
    "name": "TapIt",
    "slug": "tapit-mobile",
    "scheme": "com.tapit.app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.tapit.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tap-it-pied.vercel.app",
              "pathPrefix": "/checkin/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow TapIt to use your location to verify check-ins at participating fitness locations."
        }
      ],
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "26be12f6-4cf3-4bf3-800b-4c988415037d"
      }
    },
    "owner": "quentincng"
  }
}
